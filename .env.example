# SentinelX MVP - Environment Variables
# Copy to .env and fill in your values

# Application
APP_NAME=SentinelX MVP
APP_VERSION=0.1.0
DEBUG=true

# Database (SQLite path relative to project root)
DATABASE_URL=sqlite+aiosqlite:///data/sentinelx.db

# Encryption Key (MUST be 64 hex characters = 32 bytes)
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=change_me_to_64_hex_chars_from_os_urandom_32

# JWT Secret
JWT_SECRET=change_me_to_a_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Polymarket API
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_api_passphrase

# Polygon RPC
RPC_URL=https://polygon-rpc.com
CHAIN_ID=137

# Web App URL (for Bot deep links)
WEB_APP_URL=http://localhost:8000
